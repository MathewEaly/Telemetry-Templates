// use this query to follow along what happens in a single session. Can be useful when troubleshooting.
traces
| where timestamp between (datetime(10-10-23) .. datetime(10-12-23)) // Modify as needed
| where operation_Id == '<insert session id here>'
| extend eventId = customDimensions.eventId 
, alObjectId = customDimensions.alObjectId
, alObjectName = customDimensions.alObjectName
, alObjectType = customDimensions.alObjectType
| project 
LocalTime=datetime_utc_to_local(timestamp , 'America/New_York')
, eventId
, operation_Id
, message
, alObjectId
, alObjectName
, alObjectType
, customDimensions
| order by LocalTime asc